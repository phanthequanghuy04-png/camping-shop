# Biến môi trường cho app Camping Shop (Vite) — copy thành `.env` khi cần.
# KHÔNG commit file `.env` (đã có trong .gitignore). Các giá trị dưới đây
# chỉ là ví dụ — điền thông tin thật của shop trước khi mở bán.

# URL backend API (build-time — đổi URL thì phải build lại frontend).
# Để trống = http://localhost:3001 (chạy local). Khi backend đã lên cloud:
# VITE_API_URL=https://camping-shop-api.up.railway.app
VITE_API_URL=

# Tài khoản nhận tiền khi khách chọn "Chuyển khoản ngân hàng / VietQR".
# VietQR cần đúng MÃ NGÂN HÀNG (vd VCB = Vietcombank, TCB = Techcombank,
# MB = MB Bank, ACB, BIDV, VPB, TPB...). Chưa điền đủ 3 trường bắt buộc
# (CODE + ACCOUNT + HOLDER) thì trang thanh toán sẽ KHÔNG hiện mã QR mà
# chỉ hiện "shop sẽ liên hệ gửi thông tin chuyển khoản".
VITE_BANK_CODE=
VITE_BANK_NAME=
VITE_BANK_ACCOUNT=
VITE_BANK_HOLDER=
