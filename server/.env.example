# Camping Shop — cấu hình backend API
# Copy file này thành `.env` rồi sửa cho khớp máy của bạn.
# MySQL local (luồng khác đang cài): user root, chưa có mật khẩu.
DB_HOST=127.0.0.1
DB_PORT=3306
# Unix socket (khuyên dùng trên máy local: root MariaDB thường chỉ đăng
# nhập được qua socket, TCP có thể báo Access denied). Bỏ trống để dùng TCP.
DB_SOCKET_PATH=/var/run/mysqld/mysqld.sock
DB_USER=root
DB_PASSWORD=
DB_NAME=camping
# Cách khác (khi deploy cloud): dùng 1 chuỗi kết nối duy nhất, ưu tiên hơn
# các biến DB_* ở trên. Thêm ?ssl=true vào cuối nếu DB bắt buộc TLS
# (vd TiDB Cloud). Northflank MySQL nội bộ KHÔNG cần ssl.
# DATABASE_URL=mysql://user:pass@host:3306/camping
# DB_SSL=true
PORT=3001
# Đổi JWT_SECRET khi chạy production. Token hiện chỉ dùng cho trang admin.
JWT_SECRET=THAY_BANG_SECRET_NGAU_NHIEN_64_KY_TU_HEX
JWT_EXPIRES_IN=7d
